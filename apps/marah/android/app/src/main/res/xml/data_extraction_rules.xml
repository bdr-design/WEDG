<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up the live save, not the local safety copies
     (fallbacks and dated copies live in backups/ and can be large). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
